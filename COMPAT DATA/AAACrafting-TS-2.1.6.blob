	[Flags]
	public enum ItemTypeMask
	{
		None = 0,
		Undefined = 1,
		Ammo = 2,
		Weapon = 4,
		Food = 8,
		Armor = 0x10,
		Tools = 0x20,
		Bow = 0x40,
		Shield = 0x80,
		Potion = 0x100,
		Material = 0x200,
		All = 0x3FF
	}
	public static class FilterManager
	{
		public static ItemTypeMask ActiveMask = ItemTypeMask.All;

		public static bool IsAllowed(ItemTypeMask mask)
		{
			return (ActiveMask & mask) != 0;
		}

		public static void Toggle(ItemTypeMask mask)
		{
			if (ActiveMask == ItemTypeMask.All)
			{
				ActiveMask = mask;
			}
			else if ((ActiveMask & mask) != 0)
			{
				ActiveMask &= ~mask;
				if (ActiveMask == ItemTypeMask.None)
				{
					ActiveMask = ItemTypeMask.All;
				}
			}
			else
			{
				ActiveMask |= mask;
			}
			PaginatorPatches.CraftingWindowPage = 1;
			if ((Object)(object)InventoryGui.instance != (Object)null)
			{
				InventoryGui.instance.UpdateCraftingPanel(false);
			}
		}

		public static void Apply(ref List<RecipeDataPair> pairs)
		{
			if (ActiveMask != ItemTypeMask.All)
			{
				pairs = pairs.Where(delegate(RecipeDataPair p)
				{
					ItemTypeMask itemTypeMask = Classify(((RecipeDataPair)(ref p)).Recipe);
					return (ActiveMask & itemTypeMask) != 0;
				}).ToList();
			}
		}

		public static ItemTypeMask Classify(Recipe r)
