					{
						_loggedError = true;
						AzuAntiArthriticCraftingPlugin.AntiArthriticCraftingLogger.LogError((object)ex.ToString());
					}
				}
			}

			private static GameObject? GetActiveGroupGameObject(InventoryGui gui)
			{
				UIGroupHandler[] uiGroups = gui.m_uiGroups;
				if (uiGroups == null)
				{
					return null;
				}
				int activeGroup = gui.m_activeGroup;
				if ((uint)activeGroup >= (uint)uiGroups.Length)
