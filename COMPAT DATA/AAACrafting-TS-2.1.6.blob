		public static void HandleJoystickNavigation(Vector2 direction)
		{
			//IL_0059: Unknown result type (might be due to invalid IL or missing references)
			//IL_0070: Unknown result type (might be due to invalid IL or missing references)
			//IL_0085: Unknown result type (might be due to invalid IL or missing references)
			//IL_009b: Unknown result type (might be due to invalid IL or missing references)
			if (KeyboardButtons.Count == 0)
			{
				Debug.LogWarning((object)"No buttons available for navigation.");
				return;
			}
			if (_selectedKeyIndex < 0)
			{
				Debug.LogWarning((object)"No key selected. Selecting the first key.");
				SelectKey(0);
				return;
			}
			int num = Mathf.CeilToInt((float)KeyboardButtons.Count / 10f);
			int num2 = _selectedKeyIndex / 10;
			int num3 = _selectedKeyIndex % 10;
			if (direction.y > 0f)
			{
				num2 = (num2 - 1 + num) % num;
			}
			else if (direction.y < 0f)
			{
				num2 = (num2 + 1) % num;
			}
			else if (direction.x > 0f)
			{
				num3 = (num3 + 1) % 10;
			}
			else if (direction.x < 0f)
			{
				num3 = (num3 - 1 + 10) % 10;
			}
			int num4 = num2 * 10 + num3;
			if (num4 >= 0 && num4 < KeyboardButtons.Count)
			{
				SelectKey(num4);
				if (ZInput.GetButtonDown("JoyButtonA") || ZInput.GetButtonDown("JoyJump"))
				{
					((UnityEvent)KeyboardButtons[_selectedKeyIndex].onClick).Invoke();
				}
			}
			else
			{
				Debug.LogWarning((object)$"HandleJoystickNavigation: Invalid new index {num4}");
			}
		}

