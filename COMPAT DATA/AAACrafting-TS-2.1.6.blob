			else if (key == "Space")
			{
				TMP_InputField? obj = targetInputField;
				obj.text += " ";
			}
			else
			{
				TMP_InputField? obj2 = targetInputField;
				obj2.text += key;
			}
			targetInputField.ActivateInputField();
			targetInputField.caretPosition = targetInputField.text.Length;
		}

		[HarmonyPostfix]
