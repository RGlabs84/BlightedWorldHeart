		}

		private static bool TryMove(InventoryGui gui, int targetIdx, Direction dir, int columns)
		{
			int count = gui.m_availableRecipes.Count;
			int num = Mathf.Clamp(targetIdx, 0, count - 1);
			if (targetIdx >= 0 && targetIdx < count)
			{
				gui.SetRecipe(num, true);
				return true;
			}
			if ((Object)(object)PaginatorPatches.CraftingWindowPaginator != (Object)null)
			{
				string text = dir switch
				{
					Direction.Down => "Pagination/PageNext", 
					Direction.Right => "Pagination/PageNext", 
					Direction.Up => "Pagination/PagePrevious", 
					Direction.Left => "Pagination/PagePrevious", 
					_ => null, 
				};
				if (!string.IsNullOrEmpty(text))
				{
					Transform val = PaginatorPatches.CraftingWindowPaginator.transform.Find(text);
					Button val2 = (Object.op_Implicit((Object)(object)val) ? ((Component)val).GetComponent<Button>() : null);
					if (Object.op_Implicit((Object)(object)val2) && ((Behaviour)val2).isActiveAndEnabled && ((Selectable)val2).interactable)
					{
						((UnityEvent)val2.onClick).Invoke();
						int count2 = gui.m_availableRecipes.Count;
						if (count2 == 0)
						{
							return true;
						}
						int num2 = SafeMod(SafeGetSelectedIndex(gui), columns);
						switch (dir)
						{
						case Direction.Down:
						{
							int num4 = Mathf.Min(num2, count2 - 1);
							gui.SetRecipe(num4, true);
							break;
						}
						case Direction.Up:
						{
							int num3 = Mathf.Min((count2 - 1) / columns * columns + num2, count2 - 1);
							gui.SetRecipe(num3, true);
							break;
						}
						case Direction.Right:
							gui.SetRecipe(0, true);
							break;
						case Direction.Left:
							gui.SetRecipe(count2 - 1, true);
							break;
						}
						return true;
					}
				}
			}
			gui.SetRecipe(num, true);
			return true;
		}

		private static int SafeMod(int a, int m)
		{
			if (m <= 0)
			{
				return 0;
			}
			int num = a % m;
			if (num >= 0)
			{
				return num;
			}
			return num + m;
		}
	}
