		internal static bool TryGetVariantFromRecipeName(string recipeName, out int variant)
		{
			variant = 0;
			if (string.IsNullOrEmpty(recipeName))
			{
				return false;
			}
			int num = recipeName.LastIndexOf("_var", StringComparison.Ordinal);
			if (num < 0)
			{
				return false;
			}
			int num2 = num + "_var".Length;
			if (num2 >= recipeName.Length)
			{
				return false;
			}
			string text = recipeName.Substring(num2);
			int i;
			for (i = 0; i < text.Length && char.IsDigit(text[i]); i++)
			{
			}
			if (i == 0)
			{
				return false;
			}
			text = text.Substring(0, i);
			if (!int.TryParse(text, out variant))
			{
				return false;
			}
			return true;
		}

		public static int CalculateMaxCraftAmount()
		{
			int num = 999;
			Recipe recipe = ((RecipeDataPair)(ref InventoryGui.instance.m_selectedRecipe)).Recipe;
			if ((Object)(object)recipe != (Object)null)
			{
				num = int.MaxValue;
				Requirement[] resources = recipe.m_resources;
				foreach (Requirement val in resources)
				{
					if (val == null || (Object)(object)val.m_resItem == (Object)null)
					{
						continue;
					}
					string text = val.m_resItem.m_itemData?.m_shared?.m_name;
					if (!string.IsNullOrEmpty(text))
					{
						int availableItems = GetAvailableItems(text);
						int amount = val.m_amount;
						if (amount > 0)
						{
							num = Mathf.Min(num, availableItems / amount);
						}
					}
				}
			}
			return Mathf.Clamp(num, 1, 999);
		}

