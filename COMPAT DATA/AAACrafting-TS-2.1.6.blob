			{
				((Component)virtualKeyboardRoot).gameObject.SetActive(false);
				DeselectKey();
			}
		}

		private static void SelectKey(int index)
		{
			DeselectKey();
			if (index >= 0 && index < KeyboardButtons.Count)
			{
				_selectedKeyIndex = index;
				Button val = KeyboardButtons[_selectedKeyIndex];
				if (!((Object)(object)val != (Object)null))
				{
					return;
				}
				HighlightButton(val, highlight: true);
				((Selectable)val).interactable = true;
				foreach (Button keyboardButton in KeyboardButtons)
				{
					if (((Object)keyboardButton).name.Contains("Space") || ((Object)keyboardButton).name.Contains("Backspace"))
					{
						((Selectable)keyboardButton).interactable = true;
					}
				}
				EventSystem current2 = EventSystem.current;
				if (current2 != null)
				{
					current2.SetSelectedGameObject(((Component)val).gameObject);
				}
			}
			else
			{
				Debug.LogWarning((object)$"SelectKey: Invalid index {index}");
			}
		}

		private static void DeselectKey()
		{
