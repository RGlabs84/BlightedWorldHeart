	[HarmonyPatch(typeof(InventoryGui), "UpdateRecipeGamepadInput")]
	internal static class UpdateRecipeGamepadInput_GridAware
	{
		private enum Direction
		{
			Up,
			Down,
			Left,
			Right
		}

		private static bool Prefix(InventoryGui __instance)
		{
			List<RecipeDataPair> availableRecipes = __instance.m_availableRecipes;
			if (availableRecipes == null || availableRecipes.Count == 0)
			{
				return false;
			}
			int num = SafeGetSelectedIndex(__instance);
			int num2 = DetectColumns(__instance);
			if (num2 <= 0)
			{
				num2 = 1;
			}
			bool flag = false;
			if (ZInput.GetButtonDown("JoyLStickDown") || ZInput.GetButtonDown("JoyDPadDown"))
			{
				flag = TryMove(__instance, num + num2, Direction.Down, num2);
			}
			else if (ZInput.GetButtonDown("JoyLStickUp") || ZInput.GetButtonDown("JoyDPadUp"))
			{
				flag = TryMove(__instance, num - num2, Direction.Up, num2);
			}
			else if (ZInput.GetButtonDown("JoyLStickRight") || ZInput.GetButtonDown("JoyDPadRight"))
			{
				flag = TryMove(__instance, num + 1, Direction.Right, num2);
			}
			else if (ZInput.GetButtonDown("JoyLStickLeft") || ZInput.GetButtonDown("JoyDPadLeft"))
			{
				flag = TryMove(__instance, num - 1, Direction.Left, num2);
			}
			return !flag;
		}

		private static int SafeGetSelectedIndex(InventoryGui gui)
		{
			//IL_000b: Unknown result type (might be due to invalid IL or missing references)
			//IL_0010: Unknown result type (might be due to invalid IL or missing references)
			//IL_005d: Unknown result type (might be due to invalid IL or missing references)
			//IL_0062: Unknown result type (might be due to invalid IL or missing references)
			for (int i = 0; i < gui.m_availableRecipes.Count; i++)
			{
				RecipeDataPair val = gui.m_availableRecipes[i];
				if ((Object)(object)((RecipeDataPair)(ref val)).Recipe == (Object)(object)((RecipeDataPair)(ref gui.m_selectedRecipe)).Recipe && ((RecipeDataPair)(ref val)).ItemData == ((RecipeDataPair)(ref gui.m_selectedRecipe)).ItemData)
				{
					return i;
				}
			}
			for (int j = 0; j < gui.m_availableRecipes.Count; j++)
			{
				RecipeDataPair val2 = gui.m_availableRecipes[j];
				Transform val3 = ((RecipeDataPair)(ref val2)).InterfaceElement.transform.Find("selected");
				if (Object.op_Implicit((Object)(object)val3) && ((Component)val3).gameObject.activeSelf)
				{
					return j;
				}
			}
			return 0;
		}

		private static int DetectColumns(InventoryGui gui)
		{
			//IL_0037: Unknown result type (might be due to invalid IL or missing references)
			//IL_003d: Invalid comparison between Unknown and I4
			//IL_0075: Unknown result type (might be due to invalid IL or missing references)
			//IL_0080: Unknown result type (might be due to invalid IL or missing references)
			//IL_0098: Unknown result type (might be due to invalid IL or missing references)
			//IL_009d: Unknown result type (might be due to invalid IL or missing references)
			//IL_00a7: Unknown result type (might be due to invalid IL or missing references)
			Transform obj = ((Component)gui.m_crafting).transform.Find("RecipeList/Recipes/ListRoot");
			RectTransform val = (RectTransform)(object)((obj is RectTransform) ? obj : null);
			if (!Object.op_Implicit((Object)(object)val))
			{
				return 1;
			}
			GridLayoutGroup component = ((Component)val).GetComponent<GridLayoutGroup>();
			if (!Object.op_Implicit((Object)(object)component))
			{
				return 1;
			}
			if ((int)component.constraint == 1 && component.constraintCount > 0)
			{
				return component.constraintCount;
			}
			Transform obj2 = ((Component)gui.m_crafting).transform.Find("RecipeList/Recipes");
			RectTransform val2 = (RectTransform)(object)((obj2 is RectTransform) ? obj2 : null);
			if (!Object.op_Implicit((Object)(object)val2))
			{
				return 1;
			}
			float num = component.cellSize.x + component.spacing.x;
			if (num <= 1f)
