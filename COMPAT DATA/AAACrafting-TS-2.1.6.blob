	public class TillValhallaPlugin : ModCompat
	{
		internal const string GUID = "kwilson.TillValhalla";

		private static readonly System.Version MinVersion = new System.Version(2, 4, 6);

		private static Type ClassType()
		{
			Type? type = Type.GetType("TillValhalla.Configurations.Sections.CraftingStationConfiguration, TillValhalla");
			if (type == null)
			{
				AzuAntiArthriticCraftingPlugin.AntiArthriticCraftingLogger.LogError((object)"TillValhallaPlugin.ClassType() failed to find type");
			}
			return type;
		}

		public static bool IsLoaded()
		{
			if (Chainloader.PluginInfos.ContainsKey("kwilson.TillValhalla"))
			{
				return Chainloader.PluginInfos["kwilson.TillValhalla"].Metadata.Version >= MinVersion;
			}
			return false;
		}

		public static ConfigEntry<bool>? CFCEnabled()
		{
			ConfigEntry<bool>? field = ModCompat.GetField<ConfigEntry<bool>>(ClassType(), null, "craftFromChests");
			if (field == null)
			{
				AzuAntiArthriticCraftingPlugin.AntiArthriticCraftingLogger.LogError((object)"TillValhallaPlugin.CFCEnabled() failed to find config entry");
			}
			return field;
		}

		public static ConfigEntry<int>? GetCraftingRange()
		{
			ConfigEntry<int>? field = ModCompat.GetField<ConfigEntry<int>>(ClassType(), null, "craftFromChestRange");
			if (field == null)
			{
				AzuAntiArthriticCraftingPlugin.AntiArthriticCraftingLogger.LogError((object)"TillValhallaPlugin.GetCraftingRange() failed to find config entry");
			}
			return field;
		}
	}
}
