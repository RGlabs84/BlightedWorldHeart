						if (((Object)((Component)__instance.m_uiGroups[__instance.m_activeGroup]).gameObject).name != ((Object)AAACraft.inputAmount).name && ((Object)((Component)__instance.m_uiGroups[__instance.m_activeGroup]).gameObject).name != ((Object)PaginatorPatches.CraftingWindowInputField).name)
						{
