			PageFlipOnly = false;
			if (inputCount == LastInputRecipeCount && fav == LastFavOnly)
			{
				return string.Equals(search ?? "", LastSearch ?? "", StringComparison.Ordinal);
			}
			return false;
		}

		internal static void Save(string search, bool fav, int filterHash, int inputCount, List<Recipe> full)
		{
			LastSearch = search ?? "";
			LastFavOnly = fav;
			LastFilterHash = filterHash;
			LastInputRecipeCount = inputCount;
			CraftSortedFiltered = full;
			PageFlipOnly = false;
		}

		internal static void Invalidate()
		{
			CraftSortedFiltered.Clear();
			LastInputRecipeCount = -1;
			PageFlipOnly = false;
		}
	}
