			internal static void HandleJoysticks()
			{
				//IL_0000: Unknown result type (might be due to invalid IL or missing references)
				//IL_0005: Unknown result type (might be due to invalid IL or missing references)
				//IL_0066: Unknown result type (might be due to invalid IL or missing references)
				//IL_0067: Unknown result type (might be due to invalid IL or missing references)
				//IL_0073: Unknown result type (might be due to invalid IL or missing references)
				Vector2 zero = Vector2.zero;
				if (ZInput.GetButtonDown("JoyLStickUp"))
				{
					zero.y = 1f;
				}
				if (ZInput.GetButtonDown("JoyLStickDown"))
				{
					zero.y = -1f;
				}
				if (ZInput.GetButtonDown("JoyLStickLeft"))
				{
					zero.x = -1f;
				}
				if (ZInput.GetButtonDown("JoyLStickRight"))
				{
					zero.x = 1f;
				}
				if (zero != Vector2.zero)
				{
					InventoryGuiPatches.HandleJoystickNavigation(zero);
				}
			}

			private static void HandlePageChange(InventoryGui inventoryGui)
			{
				if (ZInput.GetButtonDown("JoyDPadLeft") && PaginatorPatches.CraftingWindowPage > 1)
				{
					PaginatorPatches.CraftingWindowPage--;
					inventoryGui.UpdateCraftingPanel(false);
				}
				if (ZInput.GetButtonDown("JoyDPadRight") && PaginatorPatches.CraftingWindowPage < AzuAntiArthriticCrafting.Utilities.Utilities.GetMaxPage())
				{
					PaginatorPatches.CraftingWindowPage++;
					inventoryGui.UpdateCraftingPanel(false);
				}
			}

			internal static void FocusInputField(TMP_InputField inputField)
			{
				if (!((Object)(object)inputField == (Object)null) && !((Object)(object)EventSystem.current == (Object)null))
				{
					if (!((Selectable)inputField).interactable || !((Component)inputField).gameObject.activeInHierarchy)
					{
						((Component)inputField).gameObject.SetActive(true);
						((Selectable)inputField).interactable = true;
					}
					EventSystem.current.SetSelectedGameObject(((Component)inputField).gameObject);
					inputField.ActivateInputField();
				}
			}
		}

