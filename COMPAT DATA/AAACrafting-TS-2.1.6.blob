	private void StartTutorial()
	{
		currentStep = 0;
		tutorialActive = true;
		UpdateTutorialStep();
	}

	private void UpdateTutorialStep()
	{
		if (currentStep >= tutorialSteps.Length)
		{
			return;
		}
