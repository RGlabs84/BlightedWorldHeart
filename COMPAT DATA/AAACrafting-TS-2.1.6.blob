		public static string MakeKey(Recipe r)
		{
			if (r.m_amount <= 1)
			{
				return ((Object)r).name;
			}
			return $"{((Object)r).name}|x{r.m_amount}";
		}

		public static bool IsFavoriteKey(string key)
		{
			return favoriteItems.Contains(key);
		}

		public static bool IsFavorite(Recipe r)
		{
			return IsFavoriteKey(MakeKey(r));
		}

		public static bool IsFavorite(RecipeDataPair pair)
		{
			return IsFavoriteKey(MakeKey(((RecipeDataPair)(ref pair)).Recipe));
		}

		public static void ToggleFavorite(string key, bool forceRebuild = false)
		{
			if (string.IsNullOrEmpty(key))
			{
				return;
			}
			if (favoriteItems.Contains(key))
			{
				favoriteItems.Remove(key);
			}
			else
			{
				favoriteItems.Add(key);
			}
			PlayerPrefs.SetString("favoriteItems", string.Join(",", favoriteItems));
			PlayerPrefs.Save();
			if (forceRebuild || favoritesOnly)
			{
				InventoryGui instance = InventoryGui.instance;
				if (instance != null)
				{
					instance.UpdateCraftingPanel(false);
				}
			}
		}

		public static void LoadFavorites()
		{
			if (PlayerPrefs.HasKey("favoriteItems"))
			{
				favoriteItems = new HashSet<string>(PlayerPrefs.GetString("favoriteItems").Split(new char[1] { ',' }));
			}
		}

		public static void DeleteFavorites()
		{
			PlayerPrefs.DeleteKey("favoriteItems");
			PlayerPrefs.Save();
			favoriteItems.Clear();
			InventoryGui.instance.UpdateCraftingPanel(false);
		}

