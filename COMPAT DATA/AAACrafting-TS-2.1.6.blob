						{
							FocusInputField(PaginatorPatches.CraftingWindowInputField);
							InventoryGuiPatches.SetTargetInputField(PaginatorPatches.CraftingWindowInputField);
							HandleJoysticks();
						}
						if (((Object)((Component)__instance.m_uiGroups[__instance.m_activeGroup]).gameObject).name == ((Object)AAACraft.inputAmount).name)
						{
