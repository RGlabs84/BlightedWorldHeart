		private static void OnPlus()
		{
			Step(1);
		}

		private static void OnMinus()
		{
			Step(-1);
		}

		private static void Step(int dir)
		{
			if (UnityInput.Current.GetKey((KeyCode)306))
			{
				amount = ((dir <= 0) ? 1 : GetMaxAmountCached());
			}
			else
			{
				int num = ((!UnityInput.Current.GetKey((KeyCode)304)) ? 1 : 10);
				amount += dir * num;
				amount = Mathf.Clamp(amount, 1, 100);
			}
			if (Object.op_Implicit((Object)(object)InventoryGui.instance))
			{
				ItemData itemData = ((RecipeDataPair)(ref InventoryGui.instance.m_selectedRecipe)).ItemData;
				if (itemData != null)
				{
					int maxQuality = itemData.m_shared.m_maxQuality;
					int quality = itemData.m_quality;
					if (maxQuality > 0)
					{
						amount = Mathf.Clamp(amount, 1, maxQuality - quality);
					}
				}
			}
			if (Object.op_Implicit((Object)(object)inputAmount) && inputAmount.text != amount.ToString())
			{
				inputAmount.SetTextWithoutNotify(amount.ToString());
			}
		}

		private static void OnInputChanged(string s)
		{
			if (!string.IsNullOrWhiteSpace(s) && int.TryParse(s, out var result))
			{
				result = Mathf.Clamp(result, 1, 100);
				if (result != amount)
				{
					amount = result;
				}
			}
		}

		private static void OnInputEndEdit(string s)
		{
			if ((UnityInput.Current.GetKeyDown((KeyCode)13) || UnityInput.Current.GetKeyDown((KeyCode)271)) && Object.op_Implicit((Object)(object)craftButton) && ((Selectable)craftButton).interactable)
			{
				((UnityEvent)craftButton.onClick).Invoke();
			}
			if (!int.TryParse(s, out var result))
			{
				result = 1;
			}
			result = Mathf.Clamp(result, 1, 100);
			amount = result;
			if (Object.op_Implicit((Object)(object)inputAmount) && inputAmount.text != amount.ToString())
			{
				inputAmount.SetTextWithoutNotify(amount.ToString());
			}
		}

		private static int GetMaximumAmount(Recipe recipe, Player player)
		{
			if (player.NoCostCheat())
			{
				return 100;
			}
			CraftingStation currentCraftingStation = player.GetCurrentCraftingStation();
			if (Object.op_Implicit((Object)(object)recipe.GetRequiredStation(1)) && (!Object.op_Implicit((Object)(object)currentCraftingStation) || !currentCraftingStation.CheckUsable(player, false)))
			{
				return 0;
			}
			if (ZoneSystem.instance.GetGlobalKey((GlobalKeys)20))
			{
				return 100;
			}
			if (!recipe.m_requireOnlyOneIngredient)
			{
				return BinarySearchMax(player, recipe);
			}
			tempRecipe.m_item = recipe.m_item;
			tempRecipe.m_amount = recipe.m_amount;
			tempRecipe.m_enabled = recipe.m_enabled;
			tempRecipe.m_qualityResultAmountMultiplier = recipe.m_qualityResultAmountMultiplier;
			tempRecipe.m_craftingStation = recipe.m_craftingStation;
			tempRecipe.m_repairStation = recipe.m_repairStation;
			tempRecipe.m_minStationLevel = recipe.m_minStationLevel;
			tempRecipe.m_listSortWeight = recipe.m_listSortWeight;
			tempRecipe.m_requireOnlyOneIngredient = false;
			tempRecipe.m_resources = (Requirement[])(object)new Requirement[1];
			int num = 0;
			for (int i = 0; i < recipe.m_resources.Length; i++)
			{
				Requirement val = recipe.m_resources[i];
				if (Object.op_Implicit((Object)(object)val?.m_resItem) && player.IsKnownMaterial(val.m_resItem.m_itemData.m_shared.m_name) && val.m_amount >= 1)
				{
					tempRecipe.m_resources[0] = val;
					num += BinarySearchMax(player, tempRecipe);
					if (num >= 100)
					{
						return 100;
					}
				}
			}
			return num;
		}

		private static int BinarySearchMax(Player player, Recipe recipe)
		{
			Player player2 = player;
			Recipe recipe2 = recipe;
			if (!HaveReq(1))
			{
				return 0;
			}
			int num = 1;
			int num2 = 100;
			while (num < num2)
			{
				int num3 = (num + num2 + 1) / 2;
				if (HaveReq(num3))
				{
					num = num3;
				}
				else
				{
					num2 = num3 - 1;
				}
			}
			return num;
			bool HaveReq(int amt)
			{
				return player2.HaveRequirements(recipe2, false, 1, amt);
			}
		}

		internal static int GetMaxAmountCached()
		{
			return CalculateMaxCraftAmount();
		}

		public static int CalculateMaxCraftAmount()
		{
			InventoryGui instance = InventoryGui.instance;
			Player localPlayer = Player.m_localPlayer;
			if (!Object.op_Implicit((Object)(object)instance) || !Object.op_Implicit((Object)(object)localPlayer))
			{
				return 0;
			}
			Recipe recipe = ((RecipeDataPair)(ref instance.m_selectedRecipe)).Recipe;
			if (!Object.op_Implicit((Object)(object)recipe))
			{
				return 0;
			}
			if (((RecipeDataPair)(ref instance.m_selectedRecipe)).ItemData != null)
			{
				return 1;
			}
			if (localPlayer.NoCostCheat() || (Object.op_Implicit((Object)(object)ZoneSystem.instance) && ZoneSystem.instance.GetGlobalKey((GlobalKeys)20)))
			{
				return 100;
			}
			if (Object.op_Implicit((Object)(object)recipe.GetRequiredStation(1)))
			{
				CraftingStation currentCraftingStation = localPlayer.GetCurrentCraftingStation();
				if (!Object.op_Implicit((Object)(object)currentCraftingStation) || !currentCraftingStation.CheckUsable(localPlayer, false))
				{
					return 0;
				}
				if (currentCraftingStation.GetLevel(true) < Mathf.Max(1, recipe.m_minStationLevel))
				{
					return 0;
				}
			}
			int num2;
			if (recipe.m_requireOnlyOneIngredient)
			{
				int num = 0;
				Requirement[] resources = recipe.m_resources;
				foreach (Requirement val in resources)
				{
					if (val == null || (Object)(object)val.m_resItem == (Object)null || val.m_amount < 1)
					{
						continue;
					}
					string text = val.m_resItem.m_itemData?.m_shared?.m_name ?? "";
					if (!string.IsNullOrEmpty(text) && localPlayer.IsKnownMaterial(text))
					{
						int availableItems = AzuAntiArthriticCrafting.Utilities.Utilities.GetAvailableItems(text);
						num += availableItems / val.m_amount;
						if (num >= 100)
						{
							num = 100;
							break;
						}
					}
				}
				num2 = num;
			}
			else
			{
				int num3 = int.MaxValue;
				bool flag = false;
				Requirement[] resources2 = recipe.m_resources;
				foreach (Requirement val2 in resources2)
				{
					if (val2 != null && !((Object)(object)val2.m_resItem == (Object)null) && val2.m_amount >= 1)
					{
						flag = true;
						string text2 = val2.m_resItem.m_itemData?.m_shared?.m_name ?? "";
						if (string.IsNullOrEmpty(text2))
						{
							num3 = 0;
							break;
						}
						int num4 = AzuAntiArthriticCrafting.Utilities.Utilities.GetAvailableItems(text2) / val2.m_amount;
						if (num4 < num3)
						{
							num3 = num4;
						}
						if (num3 == 0)
						{
							break;
						}
					}
				}
				num2 = (flag ? num3 : 0);
			}
			return Mathf.Clamp(num2, 1, 100);
		}

		private static string GetNumbersString()
		{
			string text = CombinedResAmount();
			if (string.IsNullOrWhiteSpace(text))
			{
				return text;
			}
			string text2 = Regex.Replace(Regex.Replace(text, "<.*?>", string.Empty), "[^\\d]", string.Empty);
			if (((RecipeDataPair)(ref InventoryGui.instance.m_selectedRecipe)).Recipe.m_requireOnlyOneIngredient)
			{
				text2 += Mathf.Sin(Time.time * 5f) > 0f;
			}
			AzuAntiArthriticCraftingPlugin.AntiArthriticCraftingLogger.LogError((object)("Returning numbers with value: " + text2));
			return text2;
		}

		private static string CombinedResAmount()
		{
			if (resAmountElements.Count == 0)
			{
				for (int i = 0; i < InventoryGui.instance.m_recipeRequirementList.Length; i++)
				{
					Transform obj = InventoryGui.instance.m_recipeRequirementList[i].transform.Find("res_amount");
					TMP_Text val = ((obj != null) ? ((Component)obj).GetComponent<TMP_Text>() : null);
					if (Object.op_Implicit((Object)(object)val))
					{
						resAmountElements.Add(val);
					}
				}
			}
			if (resAmountElements.Count == 0)
			{
				return "";
			}
			bool flag = false;
			sb.Clear();
			foreach (TMP_Text resAmountElement in resAmountElements)
			{
				if ((Object)(object)resAmountElement == (Object)null)
				{
					flag = true;
					break;
				}
				if (((Behaviour)resAmountElement).isActiveAndEnabled)
				{
					sb.Append(resAmountElement.text);
				}
			}
			if (flag)
			{
				resAmountElements.Clear();
				return CombinedResAmount();
			}
			return sb.ToString();
		}
	}
