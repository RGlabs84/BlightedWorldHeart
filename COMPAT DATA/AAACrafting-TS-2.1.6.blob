		internal static void OnFilterChanged()
		{
			RecipeListPerfCache.Invalidate();
			PaginatorPatches.CraftingWindowPage = 1;
			InventoryGui instance = InventoryGui.instance;
			if (instance != null)
			{
				instance.UpdateCraftingPanel(false);
			}
		}

		internal static int GetPerPage()
		{
			return RecipeListFixer.PerPage;
		}

		internal static int GetMaxPage()
		{
			int recipesCount = PaginatorPatches.InventoryGuiUpdateRecipeListPatch.RecipesCount;
			int perPage = GetPerPage();
			return (int)Math.Ceiling((float)recipesCount / (float)perPage);
		}

