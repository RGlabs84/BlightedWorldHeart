				{
					HighlightButton(val, highlight: false);
					((Selectable)val).interactable = false;
				}
			}
			foreach (Button keyboardButton in KeyboardButtons)
			{
				if (!((Object)keyboardButton).name.Contains("Space") && !((Object)keyboardButton).name.Contains("Backspace"))
				{
					((Selectable)keyboardButton).interactable = false;
				}
			}
			_selectedKeyIndex = -1;
		}

