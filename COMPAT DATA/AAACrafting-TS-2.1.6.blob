			//IL_00e4: Invalid comparison between Unknown and I4
			//IL_00ea: Unknown result type (might be due to invalid IL or missing references)
			//IL_00ef: Unknown result type (might be due to invalid IL or missing references)
			//IL_00f0: Unknown result type (might be due to invalid IL or missing references)
			//IL_00f3: Invalid comparison between Unknown and I4
			//IL_00f5: Unknown result type (might be due to invalid IL or missing references)
			//IL_00f8: Invalid comparison between Unknown and I4
			//IL_011a: Unknown result type (might be due to invalid IL or missing references)
			//IL_0120: Invalid comparison between Unknown and I4
			//IL_0129: Unknown result type (might be due to invalid IL or missing references)
			//IL_0130: Invalid comparison between Unknown and I4
			if ((Object)(object)r == (Object)null || (Object)(object)r.m_item == (Object)null || r.m_item.m_itemData == null)
			{
				return ItemTypeMask.Undefined;
			}
			SharedData shared = r.m_item.m_itemData.m_shared;
			if (shared == null)
			{
				return ItemTypeMask.Undefined;
			}
			if ((int)shared.m_itemType == 2 && (shared.m_food > 0f || shared.m_foodStamina > 0f || shared.m_foodEitr > 0f || shared.m_foodRegen > 0f))
			{
				return ItemTypeMask.Food;
			}
			if ((int)shared.m_itemType == 1)
			{
				return ItemTypeMask.Material;
			}
			if ((int)shared.m_itemType == 4)
			{
				return ItemTypeMask.Bow;
			}
			if ((int)shared.m_itemType == 2 && (shared.m_food > 0f || shared.m_foodStamina > 0f || shared.m_foodRegen > 0f))
			{
				return ItemTypeMask.Food;
			}
